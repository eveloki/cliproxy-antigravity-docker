# NOT READY. Default is a local build; the old experimental GHCR image is frozen.
# After a version passes CI and is published, use ghcr.io/eveloki/cliproxy-antigravity-docker:v8.0.3-0.1.3
# Use :latest only when you want to follow future successful publications.
IMAGE=cliproxy-antigravity:experimental
BIND_ADDRESS=127.0.0.1
PORT=8317
AGY_AUTO_INSTALL=true
# Optional integrity pin for the official installer script (not the agy binary).
AGY_INSTALLER_SHA256=
